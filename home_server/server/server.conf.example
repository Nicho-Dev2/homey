# Copy to server.conf and fill in.

# Jellyfin → Dashboard → API Keys → + (name it "server toggle")
JELLYFIN_API_KEY=""
JELLYFIN_URL="http://127.0.0.1:8096"
JELLYFIN_APP="Jellyfin"

# Warn before turning off if a recording starts within this many minutes
WARN_MINUTES=120

# Folder holding docker-compose.yml for Radarr/Sonarr
ARR_DIR="$HOME/homey/home_server/server/arr-stack"

# "Docker" for Docker Desktop, "OrbStack" if you use OrbStack
DOCKER_APP="Docker"

# External drive holding the media, e.g. "/Volumes/MyDrive". "on" refuses to start
# if it isn't connected, and keeps it from spinning down while the server is on.
# Leave empty if the media is on the internal disk.
MEDIA_DRIVE=""

# Upscaler: the HDHomeRun's name (or reserved IP) and the Python that runs it
HDHR_HOST="hdhomerun.local"
PYTHON="/opt/homebrew/bin/python3"
