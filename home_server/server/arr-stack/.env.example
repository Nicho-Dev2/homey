# Copy to .env and fill in.

# Surfshark: log in at my.surfshark.com → VPN → Manual setup → Router → WireGuard.
# Generate a key pair, pick any location, download the .conf file, and copy:
#   PrivateKey  → SURFSHARK_WG_PRIVATE_KEY
#   Address     → SURFSHARK_WG_ADDRESS   (usually 10.14.0.2/16)
SURFSHARK_WG_PRIVATE_KEY=
SURFSHARK_WG_ADDRESS=10.14.0.2/16
VPN_COUNTRY=United States

# One folder for downloads AND your library, so finished files are moved
# instantly instead of copied. Jellyfin points at the movies and tv folders.
#   <media folder>/downloads   <media folder>/movies   <media folder>/tv
# External drive example; for the internal disk use e.g. /Users/<you>/Media.
MEDIA_DIR=/Volumes/MyDrive/Media

# Your Mac user and group IDs (run: id -u  and  id -g). 501 / 20 is typical.
PUID=501
PGID=20
TZ=America/New_York
